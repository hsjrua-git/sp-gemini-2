# Copy this file to server/.env and fill in the values.
# server/.env is git-ignored; this template is safe to commit.
# The server reads it via `node --env-file=.env` (see package.json scripts).

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/student_panel

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-64-random-characters

# --- Optional ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
SESSION_COOKIE_SECURE=auto
TRUST_PROXY=0
CSRF_CHECK_ORIGIN=auto
# Optional comma-separated extra trusted app origins (for example the bundled
# Capacitor webview). The CSRF token is still required.
CSRF_ALLOWED_ORIGINS=

# `npm run seed-sample` refuses NODE_ENV=production by default. Set this only
# when you deliberately want the known-password demo fixture in an isolated DB.
ALLOW_SAMPLE_DATA=0
