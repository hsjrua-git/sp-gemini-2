# Copy to agent/.env. Never commit the real file: it contains a machine-user
# password and may contain provider API keys.
PANEL_BASE_URL=http://localhost:3000
KIOSK_USERNAME=cafe-kiosk
KIOSK_PASSWORD=change-me
VOICE_STAGE=2
AGENT_LANGUAGE=fa
KIOSK_PORT=3100
KIOSK_HOST=127.0.0.1
# Optional transcript DB sink. Use a dedicated role with INSERT permission on
# voice_transcripts only; never reuse the server's full DATABASE_URL.
AGENT_DATABASE_URL=

LLM_PROVIDER=auto
# Non-loopback URLs can send dialogue/tool context outside the LAN.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

STT_PROVIDER=auto
# A remote URL receives microphone audio.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
WHISPER_BIN=
WHISPER_MODEL=

TTS_PROVIDER=auto
# A remote URL receives response text.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=onyx
PIPER_BIN=
PIPER_VOICE=
PIPER_CONFIG=

AUDIO_DEVICE=
VAD_THRESHOLD=500
VAD_START_MS=150
VAD_END_MS=700
